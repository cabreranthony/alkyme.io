  <title>Epoch² | Game Engine for Infinite Replayability | Alkymē</title>
  <meta name="description" content="A game engine that generates unique rules for every playthrough. Built on procedural systems and adaptive AI—same seed, same game; different seed, different rules.">

  <!-- Styles -->
  <link rel="preload" href="../../dist/assets/styles.min.css" as="style">
