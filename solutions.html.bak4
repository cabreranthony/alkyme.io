<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Theme Detection (before render) -->
  <script>(function(){try{var k="alkyme-theme",s=localStorage.getItem(k);var d=s==="dark"||(s!=="light"&&window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches);if(d)document.documentElement.setAttribute("data-theme","dark");}catch(e){}})();</script>

  <title>Solutions | Alkyme</title>
  <meta name="description" content="Three ways we help you build: venture-backed companies, proven technology platforms, and expert marketing services. From operators who've built companies from scratch.">

  <!-- Styles -->
  <link rel="preload" href="dist/assets/styles.min.css" as="style">
  <link rel="stylesheet" href="dist/assets/styles.min.css">
  <link rel="stylesheet" href="assets/css/solutions.css">

  <link rel="icon" type="image/svg+xml" href="assets/logos/alkyme-logo-black.svg">
  <meta name="theme-color" content="#fff9f0">
</head>
<body class="page-solutions">

  <!-- Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Navigation -->
  <nav class="nav">
    <div class="container">
      <div class="nav__inner">
        <a href="/" class="nav__logo">
          <img src="assets/logos/alkyme-logo-lt-hzt-black.svg" alt="Alkyme" class="nav__logo-img nav__logo-img--light">
          <img src="assets/logos/alkyme-logo-lt-hzt-cream.svg" alt="Alkyme" class="nav__logo-img nav__logo-img--dark">
        </a>

        <div class="nav__menu">
          <a href="/about" class="nav__link">About</a>
          <a href="/solutions" class="nav__link nav__link--active">Solutions</a>
          <a href="/careers" class="nav__link">Careers</a>
          <a href="/contact" class="nav__link">Contact</a>
        </div>

        <button type="button" class="nav__hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div class="nav__actions">
          <button type="button" class="alkyme-lang-trigger" style="display: none;" aria-haspopup="menu" aria-expanded="false" aria-label="Select language">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span data-alkyme-lang-code>EN</span>
          </button>
        </div>
      </div>
      <div class="nav__mobile-menu">
        <a href="/about" class="nav__link">About</a>
        <a href="/solutions" class="nav__link">Solutions</a>
        <a href="/careers" class="nav__link">Careers</a>
        <a href="/contact" class="nav__link">Contact</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main id="main-content">

    <!-- Hero Section -->
    <section class="hero hero--compact">
      <div class="container">
        <div class="hero__content">
          <h1 class="hero__title">Three ways we help you grow</h1>
          <p class="hero__description">
            We build venture-backed companies, deploy proven technology platforms, and offer expert marketing services. Choose how we work together.
          </p>
        </div>
      </div>
    </section>

    <!-- Ventures Section -->
    <section id="ventures" class="section">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">ALKYME VENTURES</span>
          <h2 class="display-title">Build venture-backed companies</h2>
          <p class="section-intro">
            We build companies from scratch with real customers. Two ventures in market right now: a game engine in alpha and healthcare AI serving 3 clients.
          </p>
        </div>

        <div class="solutions-grid solutions-grid--2col">
          <!-- Epoch2 Card -->
          <div class="solution-card">
            <div class="solution-card__media">
              <img src="assets/labs/dominion-eternal-poster.jpg" alt="Epoch2 - Dominion Eternal" class="solution-card__image">
            </div>
            <div class="solution-card__content">
              <h3 class="solution-card__title">Epoch2</h3>
              <p class="solution-card__description">
                Procedural narrative engine for game studios. Alpha with 2 partner studios testing dynamic storytelling systems.
              </p>
            </div>
          </div>

          <!-- Healthcare AI Card -->
          <div class="solution-card">
            <div class="solution-card__media">
              <video class="solution-card__video" autoplay muted loop playsinline>
                <source src="assets/images/solutions/vid_other_hospital-hall.mp4" type="video/mp4">
              </video>
            </div>
            <div class="solution-card__content">
              <h3 class="solution-card__title">Healthcare AI</h3>
              <p class="solution-card__description">
                Multi-agent marketing automation for regional health systems. 3 paying clients, 85% cost reduction vs traditional agencies.
              </p>
            </div>
          </div>
        </div>

        <div class="section-actions">
          <a href="/contact?intent=ventures" class="btn btn--primary btn--pill">Learn about ventures</a>
        </div>
      </div>
    </section>

    <!-- Technology Section -->
    <section id="technology" class="section section--alt">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">PROVEN TECHNOLOGY</span>
          <h2 class="display-title">Deploy proven technology</h2>
          <p class="section-intro">
            License battle-tested platforms proven with real customers. Compliant, production-ready, deployable in weeks.
          </p>
        </div>

        <div class="solutions-grid solutions-grid--3col">
          <!-- Seva AI Platform -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
                <line x1="6" y1="6" x2="6.01" y2="6"/>
                <line x1="6" y1="18" x2="6.01" y2="18"/>
              </svg>
              <h3 class="solution-card__title">Seva AI Platform</h3>
            </div>
            <p class="solution-card__description">
              HIPAA-compliant patient portals, AI-powered triage, telehealth integration, and automated medical record management. Serving 50,000+ patients.
            </p>
            <ul class="solution-card__features">
              <li>Deploy in 4-6 weeks with white-label branding</li>
              <li>Full source code access and data ownership</li>
              <li>SOC 2 compliant platform</li>
            </ul>
          </div>

          <!-- AI Campaign Platform -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 1v6m0 6v6"/>
                <path d="M1 12h6m6 0h6"/>
              </svg>
              <h3 class="solution-card__title">AI Campaign Platform</h3>
            </div>
            <p class="solution-card__description">
              6-agent system handling campaign research, compliance, content creation, and orchestration. Live with 3 healthcare clients, 85% cost reduction.
            </p>
            <ul class="solution-card__features">
              <li>Multi-agent AI workflow automation</li>
              <li>Industry-specific compliance built in</li>
              <li>White-label ready for agencies</li>
            </ul>
          </div>

          <!-- Custom Development -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
              <h3 class="solution-card__title">Custom Development</h3>
            </div>
            <p class="solution-card__description">
              Need something custom? We adapt our technology to your specific requirements. Real platforms, not thin API wrappers.
            </p>
            <ul class="solution-card__features">
              <li>Built on proven venture technology</li>
              <li>Production-ready from day one</li>
              <li>Built for real businesses</li>
            </ul>
          </div>
        </div>

        <div class="section-actions">
          <a href="/contact?intent=licensing" class="btn btn--primary btn--pill">Explore platforms</a>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="section">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">EXPERT SERVICES</span>
          <h2 class="display-title">Expert marketing & design</h2>
          <p class="section-intro">
            Full-service digital marketing, web design, and brand strategy from operators who've launched ventures, not just projects.
          </p>
        </div>

        <div class="solutions-grid solutions-grid--4col">
          <!-- Digital Foundation -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
              <h3 class="solution-card__title">Digital Foundation</h3>
            </div>
            <ul class="solution-card__list">
              <li>Website design & development</li>
              <li>E-commerce platforms</li>
              <li>SEO & site performance</li>
              <li>Hosting & security</li>
            </ul>
          </div>

          <!-- Growth Marketing -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"/>
                <line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/>
              </svg>
              <h3 class="solution-card__title">Growth Marketing</h3>
            </div>
            <ul class="solution-card__list">
              <li>Growth strategy & planning</li>
              <li>Paid advertising (Google, Meta, LinkedIn)</li>
              <li>Social media marketing</li>
              <li>Email & SMS campaigns</li>
              <li>Analytics & reporting</li>
            </ul>
          </div>

          <!-- Brand & Creative -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
              <h3 class="solution-card__title">Brand & Creative</h3>
            </div>
            <ul class="solution-card__list">
              <li>Brand strategy & positioning</li>
              <li>Visual identity & logo design</li>
              <li>Content writing & copywriting</li>
              <li>Photography & video production</li>
            </ul>
          </div>

          <!-- Business Operations -->
          <div class="solution-card">
            <div class="solution-card__header">
              <svg class="solution-card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
              </svg>
              <h3 class="solution-card__title">Business Operations</h3>
            </div>
            <ul class="solution-card__list">
              <li>Business strategy & planning</li>
              <li>Financial modeling & forecasting</li>
              <li>Operations & process optimization</li>
              <li>Systems integration & automation</li>
            </ul>
          </div>
        </div>

        <div class="section-actions">
          <a href="/contact?intent=services" class="btn btn--primary btn--pill">Start a project</a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2 class="cta-box__title">Ready to work together?</h2>
          <p class="cta-box__description">
            Whether you need help building a venture, proven technology, or marketing services—we bring real operator experience to every project.
          </p>
          <div class="cta-box__actions">
            <a href="/contact" class="btn btn--primary btn--pill">Get in touch</a>
            <a href="/about" class="btn btn--secondary btn--pill">Learn about us</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">

      <!-- Main Footer Navigation -->
      <div class="site-footer-nav">

        <!-- Logo Area (Left Side) -->
        <div class="site-footer-logo-area">
          <img src="assets/logos/alkyme-logo-lt-hzt-black.svg" alt="Alkyme" class="site-footer-logo site-footer-logo--light">
          <img src="assets/logos/alkyme-logo-lt-hzt-cream.svg" alt="Alkyme" class="site-footer-logo site-footer-logo--dark">
        </div>

        <!-- Navigation Sections (Right Side) -->
        <nav class="site-footer-columns">

          <!-- Support -->
          <div class="site-footer-column footer-col-support">
            <h4 class="site-footer-heading">Support</h4>
            <ul class="site-footer-list">
              <li><a href="/contact">Contact Us</a></li>
              <li><a href="mailto:hello@alkyme.io">Email Support</a></li>
              <li><a href="tel:+15598255963">Call Us</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div class="site-footer-column footer-col-legal">
            <h4 class="site-footer-heading">Legal</h4>
            <ul class="site-footer-list">
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms of Service</a></li>
            </ul>
          </div>

          <!-- Company -->
          <div class="site-footer-column footer-col-company">
            <h4 class="site-footer-heading">Company</h4>
            <ul class="site-footer-list">
              <li><a href="/about">About</a></li>
              <li><a href="/solutions">Solutions</a></li>
              <li><a href="/careers">Careers</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <!-- Solutions -->
          <div class="site-footer-column footer-col-solutions">
            <h4 class="site-footer-heading">Solutions</h4>
            <ul class="site-footer-list">
              <li><a href="/solutions#ventures">Ventures</a></li>
              <li><a href="/solutions#technology">Technology</a></li>
              <li><a href="/solutions#services">Services</a></li>
            </ul>
          </div>

        </nav>

      </div>

      <!-- Bottom Copyright Bar -->
      <div class="site-footer-legal">
        <div class="site-footer-legal-left">
          <span>&copy; <span id="year"></span> Alkyme. All rights reserved.</span>
        </div>
        <div class="site-footer-legal-right">
          <span>Los Angeles, California</span>
        </div>
      </div>

    </div>
  </footer>

  <!-- Scripts -->
  <script src="assets/js/mobile-nav.js"></script>
  <script src="assets/js/site-theme.js"></script>
  <script>document.getElementById('year').textContent = new Date().getFullYear();</script>

</body>
</html>
