<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Theme Detection (before render) -->
  <script>(function(){try{var k="alkyme-theme",s=localStorage.getItem(k);var d=s==="dark"||(s!=="light"&&window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches);if(d)document.documentElement.setAttribute("data-theme","dark");}catch(e){}})();</script>

  <title>Contact | Alkymē</title>
  <meta name="description" content="Talk to us about partnerships, investment, or joining the team. Based in downtown Los Angeles. Respond to all serious inquiries within 48 hours. Email hello@alkyme.io or call (559) 825-5963.">

  <!-- Styles -->
  <link rel="preload" href="dist/assets/styles.min.css" as="style">
  <link rel="stylesheet" href="dist/assets/styles.min.css">
  <link rel="stylesheet" href="assets/css/contact.css">

  <link rel="icon" type="image/svg+xml" href="assets/logos/alkyme-logo-black.svg">
  <meta name="theme-color" content="#fff9f0">
</head>
<body>

  <!-- Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Navigation -->
  <nav class="nav">
    <div class="container">
      <div class="nav__inner">
        <a href="/" class="nav__logo">
          <img src="assets/logos/alkyme-logo-lt-hzt-black.svg" alt="Alkymē" class="nav__logo-img nav__logo-img--light">
          <img src="assets/logos/alkyme-logo-lt-hzt-cream.svg" alt="Alkymē" class="nav__logo-img nav__logo-img--dark">
        </a>

        <div class="nav__menu">
          <a href="/about" class="nav__link">About</a>
          <a href="/solutions" class="nav__link">Solutions</a>
          <a href="/careers" class="nav__link">Careers</a>
          <a href="/contact" class="nav__link nav__link--active">Contact</a>
        </div>

        <button type="button" class="nav__hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div class="nav__actions">
          <button type="button" class="alkyme-lang-trigger" aria-haspopup="menu" aria-expanded="false" aria-label="Select language">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span data-alkyme-lang-code>EN</span>
          </button>
        </div>
      </div>
      <div class="nav__mobile-menu">
        <a href="/about" class="nav__link">About</a>
        <a href="/solutions" class="nav__link">Solutions</a>
        <a href="/careers" class="nav__link">Careers</a>
        <a href="/contact" class="nav__link">Contact</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main id="main-content">

    <!-- Hero -->
    <section class="hero hero--compact">
      <div class="container">
        <div class="hero__content">
          <h1 class="hero__title">Let's talk</h1>
          <p class="hero__description">
            Whether you're interested in partnering, investing, or joining the team—we're open to conversations.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Content -->
    <section class="section section--contact">
      <div class="container container--narrow">

        <!-- Contact Methods (Above Form) -->
        <div class="contact-methods">
          <h2 class="contact-methods__title">Reach out directly</h2>
          <div class="contact-methods__grid">

            <!-- Email Card -->
            <a href="mailto:hello@alkyme.io" class="contact-card contact-card--email">
              <div class="contact-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div class="contact-card__content">
                <div class="contact-card__label">Email us</div>
                <div class="contact-card__value">hello@alkyme.io</div>
                <div class="contact-card__note">Response within 48 hours</div>
              </div>
              <div class="contact-card__arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </a>

            <!-- Phone Card -->
            <a href="tel:+15598255963" class="contact-card contact-card--phone">
              <div class="contact-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              </div>
              <div class="contact-card__content">
                <div class="contact-card__label">Call us</div>
                <div class="contact-card__value">(559) 825-5963</div>
                <div class="contact-card__note">Mon-Fri 9AM-6PM PT</div>
              </div>
              <div class="contact-card__arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </a>

          </div>
        </div>

        <!-- Divider -->
        <div class="contact-divider">
          <span class="contact-divider__text">Or send us a message</span>
        </div>

        <!-- Contact Form Card -->
        <div class="contact-form-card">
          <div class="contact-form-card__header">
            <h2 class="contact-form-card__title">Send us a message</h2>
            <p class="contact-form-card__description">
              Fill out the form below and we'll get back to you within 2-3 business days.
            </p>
          </div>

          <form class="contact-form" action="/api/contact" method="POST">

            <!-- Name & Email Row -->
            <div class="form__row">
              <div class="form__field">
                <label for="name" class="form__label">Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form__input"
                  required
                  autocomplete="name"
                  placeholder="John Smith"
                >
              </div>

              <div class="form__field">
                <label for="email" class="form__label">Email *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form__input"
                  required
                  autocomplete="email"
                  placeholder="john@company.com"
                >
              </div>
            </div>

            <!-- Company Field -->
            <div class="form__field">
              <label for="company" class="form__label">Company (optional)</label>
              <input
                type="text"
                id="company"
                name="company"
                class="form__input"
                autocomplete="organization"
                placeholder="Your company name"
              >
            </div>

            <!-- Interest Dropdown -->
            <div class="form__field">
              <label for="interest" class="form__label">I'm interested in... *</label>
              <select id="interest" name="interest" class="form__select" required>
                <option value="">Select an option</option>
                <option value="services">Marketing & digital services</option>
                <option value="licensing">Technology licensing</option>
                <option value="partnership">Venture partnership</option>
                <option value="investment">Investment opportunities</option>
                <option value="careers">Joining the team</option>
                <option value="general">General inquiry</option>
              </select>
            </div>

            <!-- Message Textarea -->
            <div class="form__field">
              <label for="message" class="form__label">Message *</label>
              <textarea
                id="message"
                name="message"
                class="form__textarea"
                required
                rows="6"
                placeholder="Tell us a bit about what you're looking to discuss..."
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="form__actions">
              <button type="submit" class="btn btn--primary btn--large">
                Send Message
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
              </button>
            </div>

          </form>
        </div>

      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">

      <!-- Main Footer Navigation -->
      <div class="site-footer-nav">

        <!-- Logo Area (Left Side) -->
        <div class="site-footer-logo-area">
          <img src="assets/logos/alkyme-logo-lt-hzt-black.svg" alt="Alkymē" class="site-footer-logo site-footer-logo--light">
          <img src="assets/logos/alkyme-logo-lt-hzt-cream.svg" alt="Alkymē" class="site-footer-logo site-footer-logo--dark">
        </div>

        <!-- Navigation Sections (Right Side) -->
        <nav class="site-footer-columns">

          <!-- Support -->
          <div class="site-footer-column footer-col-support">
            <h4 class="site-footer-heading">Support</h4>
            <ul class="site-footer-list">
              <li><a href="/contact">Contact Us</a></li>
              <li><a href="mailto:hello@alkyme.io">Email Support</a></li>
              <li><a href="tel:+15598255963">Call Us</a></li>
              <li><a href="/solutions#case-studies">Case Studies</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div class="site-footer-column footer-col-legal">
            <h4 class="site-footer-heading">Legal</h4>
            <ul class="site-footer-list">
              <li><a href="/privacy">Privacy Policy</a></li>
              <li><a href="/terms">Terms of Service</a></li>
            </ul>
          </div>

          <!-- Company -->
          <div class="site-footer-column footer-col-company">
            <h4 class="site-footer-heading">Company</h4>
            <ul class="site-footer-list">
              <li><a href="/about">About</a></li>
              <li><a href="/careers">Careers</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <!-- Solutions -->
          <div class="site-footer-column footer-col-solutions">
            <h4 class="site-footer-heading">Solutions</h4>
            <ul class="site-footer-list">
              <li><a href="/solutions">Platform Licensing</a></li>
              <li><a href="/solutions#healthcare">Healthcare AI</a></li>
              <li><a href="/solutions#logistics">Supply Chain</a></li>
              <li><a href="/solutions#retail">E-Commerce</a></li>
            </ul>
          </div>

        </nav>

      </div>

      <!-- Bottom Copyright Bar -->
      <div class="site-footer-legal">
        <div class="site-footer-legal-left">
          <span>© <span id="year"></span> Alkymē. All rights reserved.</span>
        </div>
        <div class="site-footer-legal-right">
          <span>Los Angeles, California</span>
        </div>
      </div>

    </div>
  </footer>

  <!-- Scripts -->
  <script src="assets/js/mobile-nav.js"></script>
  <script src="assets/js/site-theme.js"></script>
  <script src="assets/js/site-lang.js"></script>
  <script>document.getElementById('year').textContent = new Date().getFullYear();</script>

</body>
</html>
